    {"id":"G02","name":"Migration","pass_requires":["migration-run-success","schema-version-proven","checksum-integrity-proven","transactional-behavior-proven"]},
    {"id":"G03","name":"Communication Health","pass_requires":["runtime-health-pass","db-backed-health-proven","no-fatal-startup-errors","fail-closed-startup"]},
    {"id":"G04","name":"Provider Verification","pass_requires":["enabled-provider-connectivity-proven","adapter-contract-proven","controlled-send-or-equivalent-proven","failure-path-proven"]},
    {"id":"G05","name":"Controlled Virtual Expert Communication","pass_requires":["identity-context-proven","agent-authorized","policy-allow-proven","authorized-tool-channel-proven","result-proven"]},
    {"id":"G06","name":"Evidence Persistence","pass_requires":["durable-evidence-written","correlation-id-present","actor-and-action-recorded","integrity-verified","evidence-retrievable"]},
    {"id":"G07","name":"Security / Authorization Evidence","pass_requires":["invalid-session-denied","revoked-session-denied","insufficient-permission-denied","cross-tenant-denied","unauthorized-action-denied","tampered-evidence-not-trusted"]},
    {"id":"G08","name":"Production Release Gate","pass_requires":["G01_PASS","G02_PASS","G03_PASS","G04_PASS","G05_PASS","G06_PASS","G07_PASS","architecture_closure_PASS","production_authorization_AUTHORIZED","exact_release_head_valid","no_mandatory_blocker"]},
    {"id":"G09","name":"Commercial Activation","pass_requires":["G08_PASS","four_team_approval_PASS"],"unlocks":["real_commercial_communication","authorized_external_side_effects","approved_virtual_expert_operations"]}
