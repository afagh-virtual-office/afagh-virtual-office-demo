    {"level":"L2","mode":"LIMITED_EXECUTION","external_side_effects":true,"requires":"explicit_policy_and_authorization"},
    {"level":"L3","mode":"AUTONOMOUS_WITHIN_POLICY","external_side_effects":true,"requires":"commercial_activation_authorized"}
