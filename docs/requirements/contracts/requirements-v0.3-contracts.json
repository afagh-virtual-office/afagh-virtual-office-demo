{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afagh-virtual-office.github.io/contracts/requirements-v0.3-contracts.schema.json",
  "title": "AFAGH Requirements v0.3 Contract Registry",
  "type": "object",
  "required": ["version", "status", "contracts"],
  "properties": {
    "version": {"const": "requirements-contracts.v0.3"},
    "status": {"enum": ["DRAFT", "REVIEW", "ACCEPTED", "BLOCKED"]},
    "contracts": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["contract_id", "requirement_family", "authority", "mandatory_fields", "verification_states", "mandatory_negative_tests"],
        "properties": {
          "contract_id": {"pattern": "^C-00[1-8]$"},
          "requirement_family": {"type": "string"},
          "authority": {"type": "string", "minLength": 1},
          "mandatory_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "verification_states": {
            "type": "array",
            "items": {"enum": ["PLANNED", "SIMULATED", "CONTROLLED", "EXECUTED", "PRODUCTION_VERIFIED"]}
          },
          "mandatory_negative_tests": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
