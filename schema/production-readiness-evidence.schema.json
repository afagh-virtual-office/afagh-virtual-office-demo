{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afagh-virtual-office.github.io/schemas/production-readiness-evidence.v1.json",
  "title": "AFAGH Production Readiness Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "release_head", "generated_at", "verifier", "evidence"],
  "properties": {
    "schema_version": {"const": "afagh-production-readiness-evidence.v1"},
    "status": {"enum": ["PASS", "BLOCKED", "UNKNOWN"]},
    "release_head": {"type": "string", "minLength": 40, "maxLength": 64},
    "generated_at": {"type": "string", "format": "date-time"},
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "version": {"type": "string"}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "status", "source", "verified_at"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "class": {"enum": ["identity", "database", "migration", "transaction", "provider", "security", "audit", "observability", "recovery", "regional"]},
          "status": {"enum": ["PASS", "BLOCKED", "UNKNOWN"]},
          "source": {"type": "string", "minLength": 1},
          "verified_at": {"type": "string", "format": "date-time"},
          "evidence_ref": {"type": "string"},
          "integrity_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "scope": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
