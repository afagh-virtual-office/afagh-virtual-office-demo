{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afagh-virtual-office.github.io/afagh-virtual-office-demo/schema/evidence.schema.json",
  "title": "AFAGH Architecture Evidence Snapshot",
  "type": "object",
  "required": ["schema_version","snapshot_type","live","source_repository","source_ref","reviewed_head","reviewed_run","gate","production","architecture_contracts","runtime_evidence","verifier","axes","blockers","evidence_sources","pipeline"],
  "properties": {
    "schema_version": {"type":"string"},
    "snapshot_type": {"type":"string"},
    "live": {"const":false},
    "source_repository": {"type":"string"},
    "source_ref": {"type":"string"},
    "reviewed_head": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "reviewed_run": {"type":"integer","minimum":1},
    "gate": {"enum":["PASSED","NOT PASSED","UNKNOWN"]},
    "production": {"enum":["READY","BLOCKED","UNKNOWN"]},
    "architecture_contracts": {"$ref":"#/$defs/counter"},
    "runtime_evidence": {"$ref":"#/$defs/counter"},
    "verifier": {"type":"object","required":["pass","total","blockers"],"properties":{"pass":{"type":"integer","minimum":0},"total":{"type":"integer","minimum":0},"blockers":{"type":"integer","minimum":0}},"additionalProperties":false},
    "axes": {"type":"object","minProperties":10,"maxProperties":10,"additionalProperties":{"type":"object","required":["level","status"],"properties":{"level":{"type":"integer","minimum":1,"maximum":4},"status":{"enum":["PASS","BLOCKED","UNKNOWN"]}},"additionalProperties":false}},
    "blockers": {"type":"array","items":{"type":"object","required":["id","title","status","reason"],"properties":{"id":{"type":"string"},"title":{"type":"string"},"status":{"enum":["BLOCKED","OPEN","UNKNOWN"]},"reason":{"type":"string"}},"additionalProperties":false}},
    "evidence_sources": {"type":"array","items":{"type":"string"}},
    "pipeline": {"type":"object","required":["contract_version","upstream_connection","snapshot_kind","publication_policy","fail_closed"],"properties":{"contract_version":{"type":"string"},"upstream_connection":{"enum":["CONNECTED","NOT_CONNECTED","UNKNOWN"]},"snapshot_kind":{"enum":["CONTROLLED","LIVE","UNKNOWN"]},"publication_policy":{"const":"VALIDATE_THEN_PUBLISH"},"fail_closed":{"const":true}},"additionalProperties":false},
    "note": {"type":"string"}
  },
  "$defs": {"counter":{"type":"object","required":["pass","total"],"properties":{"pass":{"type":"integer","minimum":0},"total":{"type":"integer","minimum":0}},"additionalProperties":false}},
  "additionalProperties": false
}
